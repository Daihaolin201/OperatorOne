{
  "name": "@op1/i18n",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./config": {
      "import": "./src/config.ts",
      "require": "./src/config.ts",
      "types": "./src/config.ts"
    },
    "./locales/*": {
      "import": "./src/locales/*",
      "require": "./src/locales/*"
    },
    "./locales/*.json": {
      "import": "./src/locales/*.json",
      "require": "./src/locales/*.json"
    },
    "./locales/*/*.json": {
      "import": "./src/locales/*/*.json",
      "require": "./src/locales/*/*.json"
    },
    "./types": {
      "import": "./src/types.ts",
      "require": "./src/types.ts",
      "types": "./src/types.ts"
    }
  },
  "peerDependencies": {
    "i18next": ">=23.0.0",
    "react": ">=18.0.0",
    "react-i18next": ">=14.0.0"
  },
  "devDependencies": {
    "@op1/typescript-config": "workspace:*",
    "typescript": "^5.8.2"
  }
}
