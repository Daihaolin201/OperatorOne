{
  "owner_agent": "op1_product",
  "contract_version": "1.0",
  "capabilities": [
    {
      "name": "generate_startup_ideas",
      "stage": "stage1_stage2",
      "purpose": "Discover and prioritize opportunities from evidence.",
      "primary_outputs": [
        "research/stage1_idea_discovery/opportunity_records.json",
        "research/stage2_idea_screening/scoring.csv",
        "research/stage2_idea_screening/decision_log.json"
      ],
      "not_responsible_for": [
        "Landing page rendering",
        "Deployment execution"
      ]
    },
    {
      "name": "create_landing_pages",
      "stage": "stage3_marketing_validation",
      "purpose": "Produce conversion-focused landing package with single CTA and evidence-traceable messaging.",
      "primary_outputs": [
        "research/landing_v1/landing_package.json",
        "research/landing_v1/landing_contract_test.latest.json",
        "research/landing_v1/landing_semantic_test.latest.json",
        "research/stage3_landing_launch/run.latest.json",
        "research/stage3_landing_launch/regression/stage3_capability_validation.latest.json",
        "research/landing_v1/build_inputs/page_spec.json"
      ],
      "required_semantics": [
        "page_mode=landing",
        "single_primary_cta",
        "no_demo_first_positioning",
        "lp_module_whitelist_enforced"
      ],
      "forbidden_default_modules": [
        "workflow_interactive",
        "metric_snapshot",
        "evidence_checklist"
      ]
    },
    {
      "name": "build_and_deploy_simple_web_products",
      "stage": "build_deploy_execution",
      "purpose": "Scaffold and deploy web pages/apps from project/page specs with reproducible tests.",
      "primary_outputs": [
        "research/stage2_web_product/run.latest.json",
        "research/build_deploy_v1/page_strategy.latest.json",
        "research/build_deploy_v1/smoke_test.latest.json",
        "research/build_deploy_v1/business_test.latest.json"
      ],
      "not_responsible_for": [
        "Opportunity scoring",
        "Landing messaging strategy authoring"
      ]
    }
  ]
}
