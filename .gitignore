# macOS
.DS_Store

# Editor / IDE
.vscode/
.idea/

# Runtime logs
*.log
logs/

# Secrets / env
.env
.env.*
*.pem
*.key

# Python / Node
.venv/
venv/
node_modules/
__pycache__/
*.pyc

# OpenClaw runtime state (never commit)
.openclaw/
**/.openclaw/

# Generated analytics artifacts
artifacts/tmp/

# Generated handoff validation reports
handoffs/_meta/
handoffs/validation_report.latest.json

# Generated Z.AI integration evidence reports (machine-local paths)
docs/evidence/zai/*.json

# Agent runtime memory (session carryover; not needed for capability reproducibility)
workspaces/*/memory/

# Large generated research dumps (regenerable)
workspaces/*/research/reddit_signals.json
workspaces/*/research/secondary_signals.json
workspaces/*/research/signal_summary.json

# Generated idea-analysis artifacts (regenerable)
workspaces/*/research/idea_longlist.json
workspaces/*/research/idea_scores.csv
workspaces/*/research/scorecard.md
workspaces/*/research/top3_briefs.md

# Stage1 marketing SEO mirrors/brief outputs (regenerable)
workspaces/*/research/stage1_marketing_seo/input/mirror.latest/
