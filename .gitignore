# macOS
.DS_Store

# Editor / IDE
.vscode/
.idea/

# Runtime logs
*.log
logs/

# Secrets / env
.env
.env.*
*.pem
*.key

# Python / Node
.venv/
venv/
node_modules/
__pycache__/
*.pyc

# OpenClaw runtime state (never commit)
.openclaw/
**/.openclaw/

# Generated analytics artifacts
artifacts/tmp/

# Generated handoff validation reports
handoffs/_meta/
handoffs/validation_report.latest.json

# Agent runtime memory (session carryover; not needed for capability reproducibility)
workspaces/*/memory/

# Large generated research dumps (regenerable)
workspaces/*/research/reddit_signals.json
workspaces/*/research/secondary_signals.json
workspaces/*/research/signal_summary.json

# Generated idea-analysis artifacts (regenerable)
workspaces/*/research/idea_longlist.json
workspaces/*/research/idea_scores.csv
workspaces/*/research/scorecard.md
workspaces/*/research/top3_briefs.md

# Stage1 marketing SEO mirrors/brief outputs (regenerable)
workspaces/*/research/stage1_marketing_seo/input/mirror.latest/

# Turborepo
.turbo/
**/.turbo/

# Next.js
**/.next/
**/out/

# Build outputs
**/dist/
**/build/

# pnpm
**/node_modules/

# Test coverage
**/coverage/
**/coverage.json

# Environment files (app-level)
apps/**/.env.local
apps/**/.env.*.local

# Sisyphus agent runtime state
.sisyphus/

# NOTE: Machine-generated run artifacts (*.latest.*, run.*.json, etc.) are INTENTIONALLY TRACKED
# These files contain critical state snapshots for audit trails and reproducibility.
# GitHub PR diffs are configured via .gitattributes to collapse these as 'linguist-generated'
# for readability, but they remain committed to the repository for full traceability.
